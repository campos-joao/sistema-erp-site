# Banco PostgreSQL na nuvem (Neon, Supabase, Railway...)
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/BANCO?sslmode=require"

# Opcional: máximo de conexões do pool (padrão 10). Use 5 com o banco local do `npx prisma dev`.
# DATABASE_POOL_MAX=5

# Segredo do Auth.js - gere com: npx auth secret  (ou: openssl rand -base64 32)
AUTH_SECRET=""

# Necessário em produção fora da Vercel (ex.: `npm start` local, VPS, Docker)
# AUTH_TRUST_HOST=true
